# API Configuration
# Mặc định trỏ về API production (Azure VM sau Nginx/TLS) qua domain — cả nhóm dùng
# chung server + DB, không cần bật docker local. Copy file này sang .env và giữ nguyên.
# Chỉ đổi khi chạy backend local: emulator Android dùng http://10.0.2.2:18080.
# Đổi .env xong phải chạy: dart run build_runner build --delete-conflicting-outputs
API_URL=https://api.locker-drone.tech/api
API_BASE_URL=https://api.locker-drone.tech

# Firebase Configuration
# Get these values from Firebase Console -> Project Settings
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
